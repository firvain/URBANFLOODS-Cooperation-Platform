# Copy to backend/.env for local development. Never commit .env.

# Application
ENV=dev
PROJECT_NAME="URBANFLOODS Cooperation Platform API"
VERSION=0.1.0
API_V1_PREFIX=/api/v1
ENABLE_DOCS=true

# Database
DATABASE_URL=postgresql+asyncpg://cooperation:cooperation_dev_password@localhost:5432/cooperation_db

# CORS: comma-separated or JSON list
ALLOWED_ORIGINS=http://localhost:5173

# Security and sessions
SECRET_KEY=change-me
FRONTEND_URL=http://localhost:5173
COOKIE_SECURE=false
SESSION_COOKIE_NAME=uf_session
SESSION_TTL_DAYS=30

# Email: Brevo SMTP relay (EU, free plan, 300 emails/day), STARTTLS on 587.
# Dev compose overrides these to send to Mailpit (localhost:1025).
# SMTP_USER: the account's SMTP login shown on Brevo's "SMTP & API" page (not the sign-in email).
# SMTP_PASSWORD: an SMTP key from that page; one key per environment (dev, prod). Never commit it.
# SMTP_FROM must be on the domain authenticated in Brevo (DKIM + DMARC): cooperation.urbanfloods.app.
# SMTP_REPLY_TO: where replies go (empty = no Reply-To header). uowm.gr cannot be the sender
# (its DMARC policy quarantines mail sent by third parties), so it is the reply address only.
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@cooperation.urbanfloods.app
SMTP_FROM_NAME="URBANFLOODS Cooperation Platform"
SMTP_REPLY_TO=urbanfloods@uowm.gr
EMAIL_ENABLED=false

# KNOWBASE public API (read-only consumer)
KNOWBASE_BASE_URL=https://knowbase.urbanfloods.app
KNOWBASE_PUBLIC_URL=https://knowbase.urbanfloods.app
KNOWBASE_TIMEOUT_SECONDS=5.0
KNOWBASE_CACHE_TTL_LIST=900
KNOWBASE_CACHE_TTL_DETAIL=21600

# Cloudflare Turnstile
TURNSTILE_ENABLED=false
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Uploads
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=5

# Moderation
REPORT_AUTO_HIDE_THRESHOLD=3
AUTO_APPROVE_AFTER_DAYS=0

# Scheduler / digest
ENABLE_SCHEDULER=false
DIGEST_HOUR_UTC=6
UNVERIFIED_PURGE_DAYS=30
ORPHAN_UPLOAD_HOURS=24

# Rate limiting / proxy
RATE_LIMIT_ENABLED=true
TRUST_PROXY_HEADERS=false

# Logging
LOG_LEVEL=INFO
LOG_JSON=false

# Content
CONTENT_LICENSE_URL=https://creativecommons.org/licenses/by/4.0/
# Project contact named in emails (e.g. when a post or discussion is not approved)
CONTACT_EMAIL=louta@uowm.gr
