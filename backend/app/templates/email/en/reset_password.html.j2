{% extends "en/_layout.html.j2" %}
{% block title %}Reset your password{% endblock %}
{% block content %}
<h1 style="font-size:22px; margin:0 0 16px;">Reset your password</h1>
<p>Hello {{ display_name }},</p>
<p>We received a request to reset the password of your account on the {{ app_name }}. The link is valid for 1 hour and can be used once.</p>
<p><a href="{{ frontend_url }}{{ reset_url }}" style="color:#0b4f8a; font-weight:bold;">Choose a new password on the {{ app_name }}</a></p>
<p style="font-size:14px;">If the link does not work, copy this address into your browser:<br>{{ frontend_url }}{{ reset_url }}</p>
<p>After the reset you will be signed out on all devices.</p>
{% endblock %}
{% block notice %}
<p style="margin:0 0 8px;">If you did not request this, ignore this email. Your password will not change.</p>
{% endblock %}
