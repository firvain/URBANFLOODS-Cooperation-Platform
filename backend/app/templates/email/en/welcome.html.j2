{% extends "en/_layout.html.j2" %}
{% block title %}Welcome to the {{ app_name }}{% endblock %}
{% block content %}
<h1 style="font-size:22px; margin:0 0 16px;">Welcome to the {{ app_name }}</h1>
<p>Hello {{ display_name }},</p>
<p>Your email address is verified. Welcome to the place where flood-management stakeholders share knowledge and good practice.</p>
<ul>
<li><a href="{{ frontend_url }}/login" style="color:#0b4f8a;">Sign in to the platform</a></li>
<li><a href="{{ frontend_url }}/blog" style="color:#0b4f8a;">Read the blog</a></li>
<li><a href="{{ frontend_url }}/forum" style="color:#0b4f8a;">Join the forum</a></li>
<li><a href="{{ frontend_url }}/knowbase" style="color:#0b4f8a;">Browse the KNOWBASE</a></li>
</ul>
<p>Your first post or forum thread is reviewed by a moderator before it is published. After that, you can post directly.</p>
{% endblock %}
