# Settings for the production-mode smoke test (scripts/smoke.sh, CI job "smoke").
#
# TEST VALUES ONLY. Nothing here is a secret and nothing here is ever used in production: the
# stack runs on localhost under its own project name (ufsmoke) and is deleted (`down -v`) after
# every run. Production reads .env.prod (see .env.prod.example), never this file.
#
# Used twice, like .env.prod: by `docker compose --env-file .env.smoke` for interpolation, and by
# the backend container as its env_file (COOPERATION_ENV_FILE below). The fixed production values
# (ENV=prod, COOKIE_SECURE, TRUST_PROXY_HEADERS, EMAIL_ENABLED, TURNSTILE_ENABLED, ...) still come
# from docker-compose.prod.yml unchanged: that is the point of the test.
# One KEY=value per line, no quotes, comments on their own lines only.

# The backend's env_file (docker-compose.prod.yml defaults to .env.prod).
COOPERATION_ENV_FILE=.env.smoke

# --- Postgres (throwaway volume, no host port) --------------------------------------------------
POSTGRES_USER=cooperation_smoke
POSTGRES_PASSWORD=smoke-test-db-password-not-a-secret
POSTGRES_DB=cooperation_smoke

# --- Security and site --------------------------------------------------------------------------
SECRET_KEY=smoke-test-secret-key-not-a-secret-0123456789abcdef
# The browser reaches the frontend nginx directly on http://localhost:3002 (no host nginx, no TLS).
# Chromium treats localhost as a secure context, so the Secure session cookie still works.
ALLOWED_ORIGINS=http://localhost:3002
FRONTEND_URL=http://localhost:3002
ENABLE_DOCS=true

# --- Email: the smoke stack's own Mailpit (docker-compose.smoke.yml), plain SMTP, no login -------
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@smoke.example.org
SMTP_FROM_NAME=URBANFLOODS Cooperation Platform (smoke test)
SMTP_REPLY_TO=reply-to@smoke.example.org
CONTACT_EMAIL=contact@smoke.example.org

# --- Cloudflare Turnstile: Cloudflare's official TEST keys ----------------------------------------
# https://developers.cloudflare.com/turnstile/troubleshooting/testing/
# Site key 1x00000000000000000000AA: visible widget that always passes (works under automation,
# on any hostname, localhost included) and yields the dummy token XXXX.DUMMY.TOKEN.XXXX.
# Secret 1x0000000000000000000000000000000AA: siteverify always answers success for that token.
# The backend still calls the real siteverify endpoint, so a form that sends no token fails.
TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# --- Frontend build (baked into the smoke image) --------------------------------------------------
VITE_TURNSTILE_SITE_KEY=1x00000000000000000000AA
VITE_DSS_URL=https://urbanfloods.finki.ukim.mk/
VITE_API_BASE_URL=

# --- Moderation -----------------------------------------------------------------------------------
REPORT_AUTO_HIDE_THRESHOLD=3
# 0 = a pending first post is never approved automatically (the smoke test approves it).
AUTO_APPROVE_AFTER_DAYS=0

# --- KNOWBASE: the real public API, GET only (the backend proxy never writes) ----------------------
KNOWBASE_BASE_URL=https://knowbase.urbanfloods.app
KNOWBASE_PUBLIC_URL=https://knowbase.urbanfloods.app

# --- Scheduler and maintenance --------------------------------------------------------------------
DIGEST_HOUR_UTC=6
UNVERIFIED_PURGE_DAYS=30
DELETED_CONTENT_RETENTION_DAYS=7

# --- Operations -----------------------------------------------------------------------------------
LOG_LEVEL=INFO
# The real per-IP limits, as in production (the suite stays inside the budgets).
RATE_LIMIT_ENABLED=true
