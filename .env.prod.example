# Production settings for docker-compose.prod.yml (read by `docker compose --env-file .env.prod`
# for interpolation and by the backend container as its env_file).
#
#   cp .env.prod.example .env.prod
#   chmod 600 .env.prod            # deploy.sh refuses to run otherwise
#
# NEVER commit .env.prod (the root .gitignore ignores .env.*). Replace every <...> placeholder.
# One KEY=value per line, no quotes, comments on their own lines only.
# Fixed production values (ENV=prod, COOKIE_SECURE, TRUST_PROXY_HEADERS, ENABLE_SCHEDULER,
# EMAIL_ENABLED, TURNSTILE_ENABLED, LOG_JSON, UPLOAD_DIR, DATABASE_URL) are set in
# docker-compose.prod.yml and cannot be overridden here.

# --- Postgres ---------------------------------------------------------------------------------
# Container-internal only (no host port). The backend's DATABASE_URL is composed from these.
POSTGRES_USER=cooperation_prod
# Hex, not base64: the password goes into a URL, where base64's "/", "+" and "=" break parsing.
#   openssl rand -hex 32
POSTGRES_PASSWORD=<generate: openssl rand -hex 32>
POSTGRES_DB=cooperation_db

# --- Security and site ------------------------------------------------------------------------
# Keys the HMACs that pseudonymise IPs and email addresses in logs; secret and stable.
#   openssl rand -hex 32
SECRET_KEY=<generate: openssl rand -hex 32>
# CORS allow-list and CSRF origin allow-list (comma-separated).
ALLOWED_ORIGINS=https://cooperation.urbanfloods.app
# Public site URL: absolute links in emails, feeds, sitemap.xml and robots.txt.
FRONTEND_URL=https://cooperation.urbanfloods.app
# Serve /api/v1/openapi.json (decided 2026-10-31: the open-data page links it).
ENABLE_DOCS=true

# --- Email (Brevo SMTP relay, EU, free plan) --------------------------------------------------
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
# Brevo > SMTP & API > SMTP: the account's SMTP login (not the account email).
SMTP_USER=<Brevo SMTP login>
# The Brevo SMTP key. The existing "cooperation-platform" key is reused (decision 2026-10-31).
SMTP_PASSWORD=<Brevo SMTP key>
# Sender on the DKIM/DMARC-authenticated domain (uowm.gr cannot be the sender).
SMTP_FROM=noreply@cooperation.urbanfloods.app
SMTP_FROM_NAME=URBANFLOODS Cooperation Platform
# Reply-To on every email; empty = no header.
SMTP_REPLY_TO=urbanfloods@uowm.gr
# Project contact named in emails (e.g. a rejected post): University of Western Macedonia.
CONTACT_EMAIL=louta@uowm.gr

# --- Cloudflare Turnstile (register, resend verification, forgot password) --------------------
# Cloudflare dashboard > Turnstile > add site cooperation.urbanfloods.app.
TURNSTILE_SITE_KEY=<Turnstile site key>
TURNSTILE_SECRET_KEY=<Turnstile secret key>

# --- Frontend build (baked into the bundle at image build time; public values) ----------------
# Same value as TURNSTILE_SITE_KEY. Changing it needs a rebuild (deploy.sh rebuilds).
VITE_TURNSTILE_SITE_KEY=<Turnstile site key>
# Unified DSS web app (nav item + home card). Empty hides both.
VITE_DSS_URL=https://urbanfloods.finki.ukim.mk/
# Empty = same origin (the frontend nginx proxies /api/ to the backend). Leave empty.
VITE_API_BASE_URL=

# --- Moderation -------------------------------------------------------------------------------
# Distinct reporters that auto-hide a post, thread, comment or reply.
REPORT_AUTO_HIDE_THRESHOLD=3
# A first post/thread still pending after this many days is approved automatically
# (0 = never). Decided 2026-10-31.
AUTO_APPROVE_AFTER_DAYS=5

# --- KNOWBASE (public REST API, server-to-server) ---------------------------------------------
# Where the backend calls the API.
KNOWBASE_BASE_URL=https://knowbase.urbanfloods.app
# Where links shown to users point.
KNOWBASE_PUBLIC_URL=https://knowbase.urbanfloods.app

# --- Scheduler and maintenance ----------------------------------------------------------------
# Hour (UTC) of the daily admin digest; the maintenance sweep runs an hour earlier.
DIGEST_HOUR_UTC=6
# Unverified accounts older than this many days are purged.
UNVERIFIED_PURGE_DAYS=30
# Deleted posts, discussions, comments and replies are kept this many days (admins can restore
# them from /admin/deleted), then removed for good (0 = never). Decided 2026-10-31; 7 is the
# default, so this line is optional.
DELETED_CONTENT_RETENTION_DAYS=7

# --- Operations -------------------------------------------------------------------------------
# DEBUG, INFO, WARNING, ERROR. Logs are JSON (docker logs, rotated 3 x 10 MB).
LOG_LEVEL=INFO
# Per-IP limits on auth and write endpoints (client IP from Cloudflare's CF-Connecting-IP).
RATE_LIMIT_ENABLED=true
