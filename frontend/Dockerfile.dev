# Development image only: Vite dev server with HMR. Used by docker-compose.yml, where the source
# is bind-mounted over /app and node_modules stays in an anonymous volume seeded from this image.
# The production image (nginx serving the built SPA) is Dockerfile.prod (M6).
FROM node:25-alpine

WORKDIR /app
RUN chown node:node /app
USER node

COPY --chown=node:node package.json package-lock.json ./
RUN npm ci

COPY --chown=node:node . .

EXPOSE 5173

# --host: listen on all interfaces so the published port reaches Vite inside the container.
CMD ["npm", "run", "dev", "--", "--host", "0.0.0.0"]
