# Frontend environment variables. Copy to .env.local for local overrides.
# Backend base URL. Local dev without Docker: http://localhost:8000
# Production builds use .env.production (empty = same origin, proxied by nginx).
VITE_API_BASE_URL=http://localhost:8000
# Unified DSS web app (nav item + home card). Empty hides both.
VITE_DSS_URL=https://urbanfloods.finki.ukim.mk/
