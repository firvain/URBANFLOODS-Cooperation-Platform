# The root .gitignore ignores `.env.*`; this build-time file holds no secrets and must be committed.
!.env.production

*.tsbuildinfo
.eslintcache
coverage/

# Generated by the Nuxt UI Vite plugin on every dev/build/test run
auto-imports.d.ts
components.d.ts

# Playwright e2e output
test-results/
playwright-report/
blob-report/
