# Docker Compose variables for the development stack (docker-compose.yml).
# Copy to .env (gitignored). Every value below is also the built-in default, so .env is optional.
# These are local development values only; production uses .env.prod (M6).

# Postgres (container urbanfloods-cooperation-db)
POSTGRES_USER=cooperation
POSTGRES_PASSWORD=cooperation_dev_password
POSTGRES_DB=cooperation_db
# Host port; change if a local Postgres already uses 5432.
POSTGRES_PORT=5432

# Host ports for the app containers
BACKEND_PORT=8000
FRONTEND_PORT=5173

# Mailpit host ports: web UI/API and SMTP
MAILPIT_UI_PORT=8025
MAILPIT_SMTP_PORT=1025

# Session signing key for the dev backend. Any string works locally; never reuse in production.
SECRET_KEY=dev-secret-change-me

# Backend tests against docker-compose.test.yml (not read by Compose; export it in your shell):
#   docker compose -f docker-compose.test.yml up -d --wait
#   cd backend && TEST_DATABASE_URL=postgresql+asyncpg://test:test@localhost:5434/test uv run pytest
# TEST_DATABASE_URL=postgresql+asyncpg://test:test@localhost:5434/test

# Unified DSS web app (link-out only; no API integration yet)
DSS_URL=https://urbanfloods.finki.ukim.mk/

# Outgoing mail from the dev stack. Leave unset to use Mailpit (http://localhost:8025).
# For a real-sending test, e.g. Brevo: SMTP_HOST=smtp-relay.brevo.com SMTP_PORT=587
# SMTP_USER=<brevo login email> SMTP_PASSWORD=<smtp key> SMTP_FROM=noreply@cooperation.urbanfloods.app
#SMTP_HOST=
#SMTP_PORT=
#SMTP_USER=
#SMTP_PASSWORD=
#SMTP_FROM=
#SMTP_FROM_NAME=
